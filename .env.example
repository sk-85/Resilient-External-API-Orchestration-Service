# Copy to .env and edit. Every setting is optional; defaults suit local development.

ORCH_ENVIRONMENT=local
ORCH_LOG_LEVEL=INFO

# SQLite for zero-setup local runs, PostgreSQL for real deployments:
ORCH_DATABASE_URL=sqlite+aiosqlite:///./orchestrator.db
# ORCH_DATABASE_URL=postgresql+asyncpg://orch:orch@localhost:5432/orchestrator

# The one upstream this service is allowed to call (callers only supply a path)
ORCH_EXTERNAL_API_BASE_URL=http://localhost:9000
ORCH_REQUEST_TIMEOUT_SECONDS=3
ORCH_TOTAL_TIMEOUT_SECONDS=15

ORCH_RETRY_MAX_ATTEMPTS=4
ORCH_RETRY_BASE_DELAY_SECONDS=0.2
ORCH_RETRY_MAX_DELAY_SECONDS=5

ORCH_BREAKER_FAILURE_THRESHOLD=5
ORCH_BREAKER_RECOVERY_SECONDS=15
ORCH_BREAKER_HALF_OPEN_MAX_CALLS=1

# Auth: none | api_key | jwt
ORCH_AUTH_MODE=none
# ORCH_API_KEYS=change-me-1,change-me-2
# ORCH_JWT_SECRET=use-a-long-random-string-at-least-32-chars

# Tracing (off by default)
ORCH_OTEL_ENABLED=false
# ORCH_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# ORCH_OTEL_CONSOLE_EXPORTER=true
